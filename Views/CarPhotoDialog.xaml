<Window x:Class="FDNJ_CSharp.Views.CarPhotoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление фотографией автомобиля"
        Height="590" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource BgBrush}">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="18"
            Padding="24">
        <StackPanel>
            <TextBlock x:Name="CarTitleText"
                       Text="Фотография автомобиля"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Выберите файл с компьютера, перетащите картинку мышкой, вставьте из буфера (Ctrl+V) или укажите ссылку"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <!-- Large Image Preview Box (Drop Zone) -->
            <Border CornerRadius="10"
                    Height="210"
                    Background="#060A14"
                    BorderBrush="{StaticResource AccentBlueBrush}"
                    BorderThickness="1.5"
                    Margin="0,0,0,14"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Border VerticalAlignment="Bottom"
                            Background="#B00F172A"
                            Padding="10,6">
                        <TextBlock x:Name="StatusHintText"
                                   Text="💡 Перетащите файл сюда или нажмите Ctrl+V для вставки скопированной картинки"
                                   FontSize="11"
                                   Foreground="#E2E8F0"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Buttons Row 1: File & Clipboard -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Button Content="📁  Выбрать файл с ПК..."
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,6,0"
                        Click="ChooseFile_Click"/>
                <Button Content="📋  Вставить из буфера (Ctrl+V)"
                        Style="{StaticResource SuccessButtonStyle}"
                        Margin="6,0,0,0"
                        Click="PasteClipboard_Click"/>
            </UniformGrid>

            <!-- URL Input Row -->
            <TextBlock Text="ИЛИ ВСТАВЬТЕ ПРЯМУЮ ССЫЛКУ НА КАРТИНКУ ИЗ ИНТЕРНЕТА (URL):"
                       FontSize="10.5"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlTextBox"
                         Grid.Column="0"
                         Height="36"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Content="🌐 Загрузить по ссылке"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="LoadUrl_Click"/>
            </Grid>

            <!-- Footer Save / Cancel -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Сбросить на стандартную"
                        Style="{StaticResource OutlineButtonStyle}"
                        FontSize="11.5"
                        Click="ResetDefault_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Отмена"
                            Style="{StaticResource OutlineButtonStyle}"
                            Width="95"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="💾  Сохранить фото"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="145"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
