<Window x:Class="FDNJ_CSharp.Views.SupplierEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поставщик"
        Height="470" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="20"
            Padding="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Добавление поставщика"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="НАЗВАНИЕ КОМПАНИИ *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Height="38" Margin="0,0,0,12"/>

            <TextBlock Text="КОНТАКТНОЕ ЛИЦО" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="ContactBox" Height="38" Margin="0,0,0,12"/>

            <TextBlock Text="ТЕЛЕФОН" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneBox" Height="38" Margin="0,0,0,12"/>

            <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Height="38" Margin="0,0,0,12"/>

            <TextBlock Text="ЮРИДИЧЕСКИЙ АДРЕС" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="AddressBox" Height="38" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
