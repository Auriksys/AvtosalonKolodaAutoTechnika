<Window x:Class="FDNJ_CSharp.Views.StatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение статуса"
        Height="310" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="20"
            Padding="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Изменение статуса автомобиля"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="CarInfoTextBlock"
                       Text="Автомобиль: "
                       FontSize="13"
                       Foreground="{StaticResource AccentBlueBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <TextBlock Text="НОВЫЙ СТАТУС"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="StatusComboBox"
                      Height="38"
                      Margin="0,0,0,14"/>

            <TextBlock Text="ПРИМЕЧАНИЕ (НЕОБЯЗАТЕЛЬНО)"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="NoteTextBox"
                     Height="36"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
