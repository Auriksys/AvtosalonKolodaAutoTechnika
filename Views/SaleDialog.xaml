<Window x:Class="FDNJ_CSharp.Views.SaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление продажи"
        Height="490" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="20"
            Padding="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Оформление продажи автомобиля"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="ВЫБОР АВТОМОБИЛЯ *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <ComboBox x:Name="CarComboBox"
                      Height="38"
                      Margin="0,0,0,12"
                      SelectionChanged="CarComboBox_SelectionChanged"/>

            <TextBlock Text="ПОКУПАТЕЛЬ (КЛИЕНТ) *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <ComboBox x:Name="ClientComboBox"
                      Height="38"
                      Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="СПОСОБ ОПЛАТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PaymentComboBox" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="ИТОГОВАЯ СУММА (₽) *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="PriceBox" Height="38"/>
                </StackPanel>
            </Grid>

            <!-- Deal Summary Card -->
            <Border Background="{StaticResource Card2Brush}"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ПАРАМЕТРЫ СДЕЛКИ:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CarDetailsText" Text="Выберите автомобиль из списка..." FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Оформить продажу"
                        Style="{StaticResource SuccessButtonStyle}"
                        Width="160"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
