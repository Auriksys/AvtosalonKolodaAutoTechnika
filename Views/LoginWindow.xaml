<Window x:Class="FDNJ_CSharp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — DRIVE Автосалон"
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="30"
            Padding="35,30">
        <StackPanel VerticalAlignment="Center">
            <!-- Logo & Brand Header -->
            <TextBlock Text="DRIVE"
                       FontSize="36"
                       FontWeight="Black"
                       Foreground="{StaticResource AccentBlueBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>

            <TextBlock Text="AUTO DEALERSHIP MANAGEMENT"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- Inputs -->
            <TextBlock Text="ЛОГИН"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="2,0,0,6"/>
            <TextBox x:Name="LoginTextBox"
                     Height="40"
                     Margin="0,0,0,16"/>

            <TextBlock Text="ПАРОЛЬ"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="2,0,0,6"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="40"
                         Margin="0,0,0,24"/>

            <!-- Login Action Button -->
            <Button Content="ВОЙТИ В СИСТЕМУ"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="44"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Click="LoginButton_Click"
                    Margin="0,0,0,20"/>

            <!-- Error message label -->
            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="{StaticResource AccentRedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,0,0,12"/>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,16"/>

            <!-- Quick Demo Credentials for Defense/Professor -->
            <TextBlock Text="Быстрый демо-вход для проверки:"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <UniformGrid Columns="3" Margin="0,0,0,0">
                <Button Content="Admin"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="3,0"
                        FontSize="11"
                        Click="QuickLogin_Admin"/>
                <Button Content="Manager"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="3,0"
                        FontSize="11"
                        Click="QuickLogin_Manager"/>
                <Button Content="Director"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="3,0"
                        FontSize="11"
                        Click="QuickLogin_Director"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
