<Window x:Class="FDNJ_CSharp.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Height="400" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="20"
            Padding="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Новый пользователь"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="ЛОГИН *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox" Height="38" Margin="0,0,0,12"/>

            <TextBlock Text="ПАРОЛЬ *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="PasswordBox" Height="38" Margin="0,0,0,12"/>

            <TextBlock Text="РОЛЬ В СИСТЕМЕ *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <ComboBox x:Name="RoleComboBox" Height="38" Margin="0,0,0,22"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
